+############### Heat soak-integration ###############
+
+# Kaldes af _HEATSOAK_BEGIN i macros/heat_soak.cfg.
+#
+# Under den drift-baserede heat soak maales Z hvert 5. minut, og et
+# skift i bedfan-hastighed midt i maaleserien flytter rundt paa varmen
+# i kammeret. Det ville dukke op som "drift" i maalingen. Derfor
+# springes ramp-forsinkelsen over, saa hastigheden ligger fast fra og
+# med baseline-maalingen.
+#
+# Chamber-beskyttelsen (chamber_limit/chamber_resume) er bevidst IKKE
+# sat ud af kraft - den skal stadig kunne skrue ned, hvis kammeret
+# bliver for varmt.
+[gcode_macro BEDFAN_SOAK_MODE]
+description: Laaser bedfans i fast hastighed under en heat soak
+gcode:
+    {% set THRESHOLD = printer["gcode_macro bedfanvars"].threshold|int %}
+    {% set BED_TARGET = printer.heater_bed.target|float %}
+
+    {% if BED_TARGET >= THRESHOLD %}
+        SET_GCODE_VARIABLE MACRO=bedfanstate VARIABLE=ramp_stage VALUE=2
+        UPDATE_DELAYED_GCODE ID=bedfan_fast_ramp DURATION=0
+        UPDATE_DELAYED_GCODE ID=bedfanloop DURATION=1
+        BEDFAN_UPDATE
+    {% endif %}
+
 ############### Monitoring Loop ###############
 
 [delayed_gcode bedfanloop]
